   variable        VEAg atom (c_myStress_Ag[1]+c_myStress_Ag[2]+c_myStress_Ag[3])/3
   variable        VETe atom (c_myStress_Te[1]+c_myStress_Te[2]+c_myStress_Te[3])/3
